# ============================================================
# SCHOOLSOUL PRODUCTION ENVIRONMENT VARIABLE TEMPLATE
# ============================================================

# Application Environment
NODE_ENV=production
PORT=10000

# Base Canonical URLs (Must use HTTPS in production)
APP_URL="https://schoolsoul-web.onrender.com"
API_URL="https://schoolsoul-web.onrender.com"

# Managed PostgreSQL Database Connection String (Render / Cloud SQL)
DATABASE_URL="postgresql://schoolsoul_admin:SECURE_PASSWORD@dpg-xxxxxx.frankfurt-postgres.render.com/schoolsouldb?sslmode=require"

# Security & Authentication Secrets (High-entropy randomly generated strings)
JWT_SECRET=""
REFRESH_SECRET=""
SESSION_SECRET=""

# ============================================================
# PESAPAL API 3.0 PAYMENT GATEWAY CONFIGURATION (PRIMARY & REQUIRED)
# ============================================================
# Environment: 'sandbox' (testing) or 'production' (live transactions)
PESAPAL_ENVIRONMENT="sandbox"

# Obtained from Pesapal Merchant Portal / Developer Dashboard
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# IPN Registration ID (Captured via POST /api/billing/pesapal/register-ipn)
PESAPAL_IPN_ID=""

# Master Payment Processing Safety Gate (Default: false for safety)
PAYMENTS_ENABLED="false"

# ============================================================
# FLUTTERWAVE PAYMENT GATEWAY CONFIGURATION (DISABLED IN PRODUCTION)
# Flutterwave is disabled for the current release. The provider abstraction
# is preserved for future multi-gateway expansion. No Flutterwave keys are required.
# ============================================================
# FLW_ENVIRONMENT="sandbox"
# FLW_SECRET_KEY=""
# FLW_PUBLIC_KEY=""
# FLW_ENCRYPTION_KEY=""
# FLW_WEBHOOK_HASH=""
# FLW_PAYMENTS_ENABLED="false"

# ============================================================
# AI & EXTERNAL INTEGRATIONS
# ============================================================
GEMINI_API_KEY=""
DISABLE_WORKER="false"
